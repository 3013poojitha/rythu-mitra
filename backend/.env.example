# Copy this file to .env. With no keys the app runs fully in MOCK AI mode.

# auto = use the real API when its key is set, otherwise mock (recommended)
# mock = always mock, even if keys are set
# live = always call the real APIs
AI_MODE=auto

ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Floating WhatsApp button: our WhatsApp number, country code first, digits only (e.g. 919876543210).
# Leave empty and the button opens WhatsApp with the greeting ready, for the farmer to pick a chat.
WHATSAPP_NUMBER=
